# Copy to .env and edit. Everything has a sane default; you can run with no .env at all.
PITBOX_DATABASE_URL=sqlite:///./pitbox.db
PITBOX_STORAGE_DIR=./storage
PITBOX_MAX_UPLOAD_MB=100
PITBOX_TEAM_NAME=MESA ARC Racing

# How access is controlled. Defaults to cloudflare, so a careless deploy fails
# closed rather than open.
#   cloudflare - Cloudflare Access decides; identity arrives in a header.
#                Requires the app to be reachable ONLY via the tunnel.
#   password   - the built-in login (scrypt + sessions), for running without
#                Cloudflare. Create accounts with scripts/create_user.py.
#   none       - wide open. Local development only; dev.ps1 sets this.
PITBOX_AUTH_MODE=cloudflare

# Set true once you are behind HTTPS (password mode only).
PITBOX_COOKIE_SECURE=false
